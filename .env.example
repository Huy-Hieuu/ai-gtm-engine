# Private Integration Token of the sub-account (Settings > Private Integrations). Never commit the real value.
GHL_PRIVATE_TOKEN=
# Sub-account (location) id: Settings > Business Profile, or the id in the app URL after /location/.
GHL_LOCATION_ID=
# GHL API v2 base URL; leave the default.
GHL_API_BASE=https://services.leadconnectorhq.com
# Step 4 booking: the calendar the agent books on, the pipeline, and its Booked stage (README Step 4.3).
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_BOOKED_STAGE_ID=
# SQLite file for webhook events, installs, leads and metrics; created on start.
DATABASE_PATH=speed_to_lead.db
# Step 6 dashboard: open /dashboard?token=<this>. Any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
# Step 5 OAuth app: Marketplace developer portal > My Apps > your app > Advanced Settings > Auth.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Exactly one of the app's Redirect URLs, e.g. https://<app>.onrender.com/oauth/callback
GHL_REDIRECT_URI=
# Encrypts OAuth tokens in the DB. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# OpenAI API key for the SMS agent (platform.openai.com/api-keys). Never commit the real value.
OPENAI_API_KEY=
# Optional: model for replies and answer reading; default gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
# Optional: who the agent texts for; shapes its questions and the fit check.
BUSINESS_DESCRIPTION=a marketing agency that builds websites and runs ads for local businesses
